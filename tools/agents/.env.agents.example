# Environment variables for containerized AI Agents (tools/agents)

# --- Google Antigravity CLI Authentication ---
# If GEMINI_API_KEY is provided, OAuth authentication will be bypassed,
# and the agent will run using the provided API Key.
GEMINI_API_KEY=

# --- GitHub Copilot CLI Authentication ---
# If GITHUB_TOKEN is provided, OAuth authentication (device flow) will be bypassed,
# and the agent will authenticate automatically using this token.
GITHUB_TOKEN=
