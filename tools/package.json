{
  "name": "@elo-organico/tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "author": "Tupynambá Lucas Varela Rodrigues <tupynambalucas.dev>",
  "description": "Elo Orgânico Tools Package",
  "license": "https://github.com/tupynambalucas/elo-organico/tree/main#license",
  "homepage": "https://github.com/tupynambalucas/elo-organico/tree/main/tools#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tupynambalucas/elo-organico.git",
    "directory": "tools"
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc",
    "mcp:up": "docker compose -f mcp/compose.yaml up -d",
    "mcp:down": "docker compose -f mcp/compose.yaml down",
    "mcp:reset": "docker compose -f mcp/compose.yaml down --volumes && docker compose -f mcp/compose.yaml up -d --build"
  },
  "dependencies": {
    "fastify": "catalog:api-stack",
    "@fastify/sse": "catalog:api-stack",
    "@fastify/http-proxy": "catalog:api-stack"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
