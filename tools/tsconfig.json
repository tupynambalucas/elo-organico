{
  "extends": "@elo-organico/config/tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@tools/*": ["./src/*"]
    }
  },
  "include": ["scripts/**/*.ts", "src/**/*.ts", "mcp/**/*.ts", "github/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist", "penpot"]
}
