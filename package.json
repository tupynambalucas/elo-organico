{
  "name": "@devtupynambalucas/elo-organico",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "author": "Tupynambá Lucas Varela Rodrigues <tupynambalucas.dev>",
  "license": "CC-BY-NC-4.0",
  "homepage": "https://tupynambalucas.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tupynambalucas/elo-organico.git"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "// Docs": "---------------------------------------------",
    "docs:dev": "pnpm --filter @elo-organico/knowledge-base start",
    "docs:dev:pt": "pnpm --filter @elo-organico/knowledge-base start:pt",
    "docs:build": "pnpm --filter @elo-organico/knowledge-base build",
    "docs:down": "kill-port 3002",
    "docs:changelog": "node tools/scripts/generate-changelog.mjs",
    "// Instance": "---------------------------------------------",
    "instance:dev": "turbo run instance:dev --filter=@elo-instance/*",
    "instance:lint": "turbo run lint --filter=@elo-instance/*",
    "instance:typecheck": "turbo run typecheck --filter=@elo-instance/*",
    "instance:web": "pnpm --filter @elo-instance/web dev",
    "instance:api": "pnpm --filter @elo-instance/api dev",
    "instance:up": "docker compose -f instance/compose.yaml up -d",
    "instance:up:prod": "docker compose -f instance/compose.yaml --env-file instance/.env.prod up -d",
    "instance:down": "docker compose -f instance/compose.yaml down && kill-port 3000 5173",
    "instance:reset": "docker compose -f instance/compose.yaml down --volumes && pnpm instance:up",
    "instance:reset:prod": "docker compose -f instance/compose.yaml --env-file instance/.env.prod down --volumes && pnpm instance:up:prod",
    "instance:deploy": "docker compose -f instance/compose.prod.yaml --env-file instance/.env.prod up -d --build",
    "instance:deploy:staging": "docker compose -f instance/compose.prod.yaml --env-file instance/.env.staging up -d --build",
    "instance:deploy:down": "docker compose -f instance/compose.prod.yaml down",
    "// Portal": "---------------------------------------------",
    "portal:dev": "turbo run portal:dev --filter=@elo-portal/*",
    "portal:lint": "turbo run lint --filter=@elo-portal/*",
    "portal:typecheck": "turbo run typecheck --filter=@elo-portal/*",
    "portal:web": "pnpm --filter @elo-portal/web dev",
    "portal:api": "pnpm --filter @elo-portal/api dev",
    "portal:up": "docker compose -f portal/compose.yaml up -d",
    "portal:up:prod": "docker compose -f portal/compose.yaml --env-file portal/.env.prod up -d",
    "portal:down": "docker compose -f portal/compose.yaml down && kill-port 3001 5174",
    "portal:reset": "docker compose -f portal/compose.yaml down --volumes && pnpm portal:up",
    "portal:reset:prod": "docker compose -f portal/compose.yaml --env-file portal/.env.prod down --volumes && pnpm portal:up:prod",
    "portal:deploy": "docker compose -f portal/compose.prod.yaml --env-file portal/.env.prod up -d --build",
    "portal:deploy:staging": "docker compose -f portal/compose.prod.yaml --env-file portal/.env.staging up -d --build",
    "portal:deploy:down": "docker compose -f portal/compose.prod.yaml down",
    "// Studio / Penpot": "---------------------------------------------",
    "penpot:up": "pnpm --filter @elo-organico/studio penpot:up",
    "penpot:down": "pnpm --filter @elo-organico/studio penpot:down",
    "penpot:reset": "pnpm --filter @elo-organico/studio penpot:reset",
    "penpot:update": "pnpm --filter @elo-organico/studio penpot:update",
    "penpot:aide:up": "pnpm --filter @elo-organico/studio aide:up",
    "penpot:aide:down": "pnpm --filter @elo-organico/studio aide:down",
    "// Tools / MCP": "---------------------------------------------",
    "mcp:up": "pnpm --filter @elo-organico/tools mcp:up",
    "mcp:down": "pnpm --filter @elo-organico/tools mcp:down",
    "mcp:reset": "pnpm --filter @elo-organico/tools mcp:reset",
    "mcp:github:up": "pnpm --filter @elo-organico/tools mcp:github:up",
    "mcp:github:down": "pnpm --filter @elo-organico/tools mcp:github:down",
    "mcp:context7:up": "pnpm --filter @elo-organico/tools mcp:context7:up",
    "mcp:context7:down": "pnpm --filter @elo-organico/tools mcp:context7:down",
    "mcp:browser:up": "pnpm --filter @elo-organico/tools mcp:browser:up",
    "mcp:browser:down": "pnpm --filter @elo-organico/tools mcp:browser:down",
    "mcp:dockerhub:up": "pnpm --filter @elo-organico/tools mcp:dockerhub:up",
    "mcp:dockerhub:down": "pnpm --filter @elo-organico/tools mcp:dockerhub:down",
    "// CI/CD & Quality": "-------------------------------------------------",
    "project:clean": "npx npkill"
  },
  "devDependencies": {
    "@eslint/js": "catalog:tooling-stack",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:tooling-stack",
    "eslint": "catalog:tooling-stack",
    "eslint-import-resolver-typescript": "catalog:tooling-stack",
    "eslint-plugin-import": "catalog:tooling-stack",
    "eslint-plugin-react": "catalog:web-stack",
    "eslint-plugin-react-hooks": "catalog:web-stack",
    "eslint-plugin-react-refresh": "catalog:web-stack",
    "kill-port": "catalog:",
    "prettier": "catalog:tooling-stack",
    "rimraf": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:tooling-stack",
    "turbo": "catalog:"
  }
}
