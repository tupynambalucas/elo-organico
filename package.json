{
  "name": "@devtupynambalucas/elo-organico",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "author": "Tupynambá Lucas Varela Rodrigues <tupynambalucas.dev>",
  "license": "CC-BY-NC-4.0",
  "homepage": "https://tupynambalucas.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tupynambalucas/elo-organico.git"
  },
  "scripts": {
    "// Docs": "---------------------------------------------",
    "docs:typecheck": "pnpm --filter @elo-organico/docs typecheck",
    "docs:lint": "pnpm --filter @elo-organico/docs lint",
    "docs:dev": "pnpm --filter @elo-organico/docs start",
    "docs:dev:pt": "pnpm --filter @elo-organico/docs start:pt",
    "docs:build": "pnpm --filter @elo-organico/docs build",
    "docs:preview": "pnpm docs:build && pnpm --filter @elo-organico/docs serve",
    "docs:clear": "pnpm --filter @elo-organico/docs clear",
    "docs:down": "npx kill-port 3002",
    "// Instance": "---------------------------------------------",
    "instance:dev": "pnpm instance:up && turbo run instance:dev --filter=@elo-instance/*",
    "instance:build": "turbo run build --filter=@elo-instance/*",
    "instance:lint": "turbo run lint --filter=@elo-instance/*",
    "instance:typecheck": "turbo run typecheck --filter=@elo-instance/*",
    "instance:up": "docker compose -f instance/compose.dev.yaml --env-file instance/.env.dev up -d",
    "instance:down": "docker compose -f instance/compose.dev.yaml --env-file instance/.env.dev down && kill-port 3000 5173",
    "instance:reset": "docker compose -f instance/compose.dev.yaml --env-file instance/.env.dev down --volumes && docker compose -f instance/compose.dev.yaml --env-file instance/.env.dev up -d --build",
    "instance:prod": "docker compose -f instance/compose.prod.yaml --env-file instance/.env.prod up -d --build",
    "instance:staging": "docker compose -f instance/compose.prod.yaml --env-file instance/.env.staging up -d --build",
    "instance:prod:down": "docker compose -f instance/compose.prod.yaml --env-file instance/.env.prod down",
    "instance:staging:down": "docker compose -f instance/compose.prod.yaml --env-file instance/.env.staging down",
    "// Portal": "---------------------------------------------",
    "portal:dev": "pnpm portal:up && turbo run portal:dev --filter=@elo-portal/*",
    "portal:build": "turbo run build --filter=@elo-portal/*",
    "portal:lint": "turbo run lint --filter=@elo-portal/*",
    "portal:typecheck": "turbo run typecheck --filter=@elo-portal/*",
    "portal:up": "docker compose -f portal/compose.dev.yaml --env-file portal/.env.dev up -d",
    "portal:down": "docker compose -f portal/compose.dev.yaml --env-file portal/.env.dev down && kill-port 3001 5174",
    "portal:reset": "docker compose -f portal/compose.dev.yaml --env-file portal/.env.dev down --volumes && docker compose -f portal/compose.dev.yaml --env-file portal/.env.dev up -d --build",
    "portal:prod": "docker compose -f portal/compose.prod.yaml --env-file portal/.env.prod up -d --build",
    "portal:staging": "docker compose -f portal/compose.prod.yaml --env-file portal/.env.staging up -d --build",
    "portal:prod:down": "docker compose -f portal/compose.prod.yaml --env-file portal/.env.prod down",
    "portal:staging:down": "docker compose -f portal/compose.prod.yaml --env-file portal/.env.staging down",
    "// Studio / Penpot": "---------------------------------------------",
    "studio:lint": "turbo run lint --filter=@elo-organico/studio",
    "studio:typecheck": "turbo run typecheck --filter=@elo-organico/studio",
    "studio:bucket": "pnpm --filter @elo-organico/studio bucket",
    "penpot:up": "pnpm --filter @elo-organico/studio penpot:up",
    "penpot:down": "pnpm --filter @elo-organico/studio penpot:down",
    "penpot:reset": "pnpm --filter @elo-organico/studio penpot:reset",
    "penpot:update": "pnpm --filter @elo-organico/studio penpot:update",
    "penpot:aide:up": "pnpm --filter @elo-organico/studio aide:up",
    "penpot:aide:down": "pnpm --filter @elo-organico/studio aide:down",
    "// Tools / MCP": "---------------------------------------------",
    "tools:lint": "turbo run lint --filter=@elo-organico/tools",
    "tools:typecheck": "turbo run typecheck --filter=@elo-organico/tools",
    "mcp:up": "pnpm --filter @elo-organico/tools mcp:up",
    "mcp:down": "pnpm --filter @elo-organico/tools mcp:down",
    "mcp:reset": "pnpm --filter @elo-organico/tools mcp:reset",
    "mcp:prod:up": "pnpm --filter @elo-organico/tools mcp:prod:up",
    "mcp:prod:down": "pnpm --filter @elo-organico/tools mcp:prod:down",
    "mcp:staging:up": "pnpm --filter @elo-organico/tools mcp:staging:up",
    "mcp:staging:down": "pnpm --filter @elo-organico/tools mcp:staging:down",
    "agents:up": "pnpm --filter @elo-organico/tools agents:up",
    "agents:down": "pnpm --filter @elo-organico/tools agents:down",
    "agents:reset": "pnpm --filter @elo-organico/tools agents:reset",
    "agents:prod:up": "pnpm --filter @elo-organico/tools agents:prod:up",
    "agents:prod:down": "pnpm --filter @elo-organico/tools agents:prod:down",
    "agents:staging:up": "pnpm --filter @elo-organico/tools agents:staging:up",
    "agents:staging:down": "pnpm --filter @elo-organico/tools agents:staging:down",
    "antigravity:up": "pnpm --filter @elo-organico/tools antigravity:up",
    "antigravity:down": "pnpm --filter @elo-organico/tools antigravity:down",
    "antigravity:reset": "pnpm --filter @elo-organico/tools antigravity:reset",
    "copilot:up": "pnpm --filter @elo-organico/tools copilot:up",
    "copilot:down": "pnpm --filter @elo-organico/tools copilot:down",
    "copilot:reset": "pnpm --filter @elo-organico/tools copilot:reset",
    "antigravity:auth": "pnpm --filter @elo-organico/tools antigravity:auth",
    "copilot:auth": "pnpm --filter @elo-organico/tools copilot:auth",
    "antigravity:prod:auth": "pnpm --filter @elo-organico/tools antigravity:prod:auth",
    "copilot:prod:auth": "pnpm --filter @elo-organico/tools copilot:prod:auth",
    "antigravity:staging:auth": "pnpm --filter @elo-organico/tools antigravity:staging:auth",
    "copilot:staging:auth": "pnpm --filter @elo-organico/tools copilot:staging:auth",
    "github:generate:changelog": "pnpm --filter @elo-organico/tools generate:changelog",
    "github:generate:roadmap": "pnpm --filter @elo-organico/tools generate:roadmap",
    "github:sync:security-quality": "pnpm --filter @elo-organico/tools github:sync:security-quality",
    "github:cli:up": "pnpm --filter @elo-organico/tools github:cli:up",
    "github:cli:down": "pnpm --filter @elo-organico/tools github:cli:down",
    "github:cli:reset": "pnpm --filter @elo-organico/tools github:cli:reset",
    "github:cli:interactive": "pnpm --filter @elo-organico/tools github:cli:interactive",
    "github:bash:up": "pnpm --filter @elo-organico/tools github:bash:up",
    "github:bash:down": "pnpm --filter @elo-organico/tools github:bash:down",
    "github:bash:reset": "pnpm --filter @elo-organico/tools github:bash:reset",
    "github:bash:interactive": "pnpm --filter @elo-organico/tools github:bash:interactive",
    "github:reset": "pnpm --filter @elo-organico/tools github:reset",
    "// CI/CD & Quality": "-------------------------------------------------",
    "format:check": "prettier --check --ignore-path shared/config/.prettierignore .",
    "format:write": "prettier --write --ignore-path shared/config/.prettierignore .",
    "version:changeset": "changeset",
    "version:bump": "changeset version",
    "version:publish": "changeset publish",
    "project:clear": "npx npkill",
    "husky:test": "tsx tools/scripts/test-hooks.ts",
    "git:ignore-compiled-docs": "git update-index --skip-worktree CHANGELOG.md ROADMAP.md",
    "git:track-compiled-docs": "git update-index --no-skip-worktree CHANGELOG.md ROADMAP.md",
    "prepare": "pnpm --filter @elo-organico/config prepare",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@elo-organico/config": "workspace:*",
    "@changesets/cli": "catalog:",
    "@clack/prompts": "catalog:",
    "@eslint/compat": "catalog:tooling-stack",
    "@eslint/js": "catalog:tooling-stack",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:tooling-stack",
    "eslint": "catalog:tooling-stack",
    "eslint-config-prettier": "catalog:tooling-stack",
    "eslint-import-resolver-typescript": "catalog:tooling-stack",
    "eslint-plugin-import": "catalog:tooling-stack",
    "eslint-plugin-mdx": "catalog:tooling-stack",
    "eslint-plugin-prettier": "catalog:tooling-stack",
    "eslint-plugin-react": "catalog:web-stack",
    "eslint-plugin-react-hooks": "catalog:web-stack",
    "eslint-plugin-react-refresh": "catalog:web-stack",
    "husky": "catalog:",
    "kill-port": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:tooling-stack",
    "rimraf": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:tooling-stack",
    "wrangler": "catalog:"
  },
  "prettier": "@elo-organico/config",
  "lint-staged": {
    "**/*.{js,mjs,ts,tsx,mdx}": [
      "eslint --fix --no-warn-ignored"
    ],
    "**/*.{json,yaml,md,css,html}": [
      "prettier --write --ignore-path shared/config/.prettierignore"
    ]
  }
}
