# ---------------------------------------------------------------- #
# PORTAL INFRASTRUCTURE — DEVELOPMENT EXAMPLE
# Copy to .env.dev and fill in your values.
# This file IS committed to version control.
# ---------------------------------------------------------------- #

# MongoDB
MONGO_USER=EloPortal
MONGO_PASSWORD=your_local_mongo_password
MONGO_DB_NAME=elo_portal_db

# Admin User Seed (used by mongo-init.js — dev only)
ADMIN_USER_SEED=admin
ADMIN_EMAIL_SEED=your-email@example.com
ADMIN_PASS_SEED=admin
