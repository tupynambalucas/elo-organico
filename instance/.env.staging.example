# ---------------------------------------------------------------- #
# INSTANCE INFRASTRUCTURE — STAGING EXAMPLE
# Copy to .env.staging and fill in your values.
# This file IS committed to version control.
# ---------------------------------------------------------------- #

# MongoDB Atlas (staging cluster)
MONGO_USER=EloInstance
MONGO_PASSWORD=CHANGE_ME_STAGING_STRONG_PASSWORD
MONGO_DB_NAME=elo_instance_db

# Admin User Seed (used on first staging deployment only)
ADMIN_USER_SEED=CHANGE_ME_STAGING_ADMIN_USERNAME
ADMIN_EMAIL_SEED=CHANGE_ME_STAGING_ADMIN_EMAIL
ADMIN_PASS_SEED=CHANGE_ME_STAGING_STRONG_ADMIN_PASSWORD

# Web build-time variables (injected as Docker ARG)
# Get your staging site key from dash.cloudflare.com
VITE_TURNSTILE_SITE_KEY=CHANGE_ME_STAGING_TURNSTILE_SITE_KEY
