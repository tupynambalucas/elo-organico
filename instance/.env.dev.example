# ---------------------------------------------------------------- #
# INSTANCE INFRASTRUCTURE — DEVELOPMENT EXAMPLE
# Copy to .env.dev and fill in your values.
# This file IS committed to version control.
#
# Scope: Docker Compose services — MongoDB (db) and db-init only.
# The API reads its own secrets from apps/api/.env.dev.
# ---------------------------------------------------------------- #

# MongoDB root credentials (used by the db container)
MONGO_USER=EloInstance
MONGO_PASSWORD=your_local_mongo_password

# NOTE: Admin user seeding is handled automatically by the API on startup
# (SeedPlugin). Configure ADMIN_*_SEED in apps/api/.env.dev instead.
