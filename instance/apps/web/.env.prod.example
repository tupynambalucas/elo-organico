# ---------------------------------------------------------------- #
# INSTANCE WEB — PRODUCTION EXAMPLE
# Copy to .env.prod and fill in your values.
# This file IS committed to version control.
# All variables MUST use VITE_ prefix to be exposed to the client.
# WARNING: These values are embedded in the client bundle. Never put secrets here.
# ---------------------------------------------------------------- #

# Cloudflare Turnstile (your production site key from dash.cloudflare.com)
VITE_TURNSTILE_SITE_KEY=CHANGE_ME_YOUR_PRODUCTION_TURNSTILE_SITE_KEY

# Cloudinary CDN Cloud Name
VITE_CLOUDINARY_CLOUD_NAME=elo-organico
