# ---------------------------------------------------------------- #
# INSTANCE WEB — DEVELOPMENT EXAMPLE
# Copy to .env.dev and fill in your values.
# This file IS committed to version control.
# All variables MUST use VITE_ prefix to be exposed to the client.
# ---------------------------------------------------------------- #

# Cloudflare Turnstile (test site key — always passes in dev)
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Cloudinary CDN Cloud Name
VITE_CLOUDINARY_CLOUD_NAME=elo-organico
