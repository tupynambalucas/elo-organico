# ---------------------------------------------------------------- #
# INSTANCE API — STAGING EXAMPLE
# Copy to .env.staging and fill in your values.
# This file IS committed to version control.
# ---------------------------------------------------------------- #

# Server
SERVER_PORT=3000
SERVER_HOST=0.0.0.0
NODE_ENV=production

# MongoDB Atlas (staging cluster)
# Format: mongodb+srv://user:pass@cluster.mongodb.net/dbname?options
MONGO_URI=mongodb+srv://CHANGE_ME_ATLAS_USERNAME:CHANGE_ME_ATLAS_PASSWORD@CHANGE_ME_STAGING_CLUSTER.mongodb.net/elo_instance_db?retryWrites=true&w=majority&appName=elo-instance-staging

# Redis (uses Docker internal network hostname defined in compose.prod.yaml)
REDIS_HOST=instance-redis
REDIS_PORT=6379

# Auth & Session Secrets (generate with: openssl rand -hex 64)
JWT_SECRET=CHANGE_ME_STAGING_JWT_SECRET
SESSION_SECRET=CHANGE_ME_STAGING_SESSION_SECRET
USER_SESSION_KEY=EloInstance

# Admin Seed (used on first staging deployment only)
ADMIN_USER_SEED=CHANGE_ME_STAGING_ADMIN_USERNAME
ADMIN_EMAIL_SEED=CHANGE_ME_STAGING_ADMIN_EMAIL
ADMIN_PASS_SEED=CHANGE_ME_STAGING_STRONG_ADMIN_PASSWORD

# External Services
SENTRY_DSN=your_sentry_dsn_here
TURNSTILE_SECRET_KEY=your_staging_turnstile_secret_key_here
