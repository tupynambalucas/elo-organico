# ---------------------------------------------------------------- #
# INSTANCE API — PRODUCTION EXAMPLE
# Copy to .env.prod and fill in your values.
# This file IS committed to version control.
# NEVER use these placeholder values in production.
# ---------------------------------------------------------------- #

# Server
SERVER_PORT=3000
SERVER_HOST=0.0.0.0
NODE_ENV=production

# MongoDB (uses Docker internal network hostname)
MONGO_URI=mongodb://YOUR_MONGO_USER:YOUR_MONGO_PASSWORD@instance-db:27017/elo_instance_db?authSource=admin&replicaSet=rs0&directConnection=true

# Redis (BullMQ — uses Docker internal network hostname)
REDIS_HOST=instance-redis
REDIS_PORT=6379

# Auth & Session Secrets (generate with: openssl rand -hex 64)
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_64
SESSION_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_64
USER_SESSION_KEY=EloInstance

# Admin Seed (used on first deployment only)
ADMIN_USER_SEED=CHANGE_ME_ADMIN_USERNAME
ADMIN_EMAIL_SEED=CHANGE_ME_ADMIN_EMAIL
ADMIN_PASS_SEED=CHANGE_ME_STRONG_ADMIN_PASSWORD

# External Services
SENTRY_DSN=your_sentry_dsn_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
